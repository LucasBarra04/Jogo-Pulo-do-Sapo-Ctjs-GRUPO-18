        lastmod: 1790470556589
        uid: MfgQntjN4t5GpP
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: Inimigo
        depth: 0
        texture: ptJCrL8crmpzBC
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: >-
              const onGround = place.occupied(this, this.x, this.y + 1,
              'Solid');


              if (onGround) {
                  this.vspeed = 0;

                  const edgeAhead = !place.occupied(this, this.x + this.dir * this.width, this.y + 1, 'Solid');
                  const wallAhead = place.occupied(this, this.x + this.dir * 2, this.y, 'Solid');

                  if (edgeAhead || wallAhead) {
                      this.dir *= -1;
                  }
              }


              this.scale.x = this.dir === -1 ? this.baseScaleX :
              -this.baseScaleX;

              this.hspeed = this.dir * this.walkSpeed;

              this.moveSmart('Solid');
            arguments: {}
          - eventKey: OnCreate
            code: |-
              this.gravity = 1800;
              this.walkSpeed = 60;
              this.dir = -1;
              this.hspeed = 0;
              this.vspeed = 0;
              this.animationSpeed = 0.15;
              this.play();
              this.baseScaleX = Math.abs(this.scale.x);
            arguments: {}
            lib: core
          - eventKey: collisionTemplate
            code: >-
              const stomping = other.vspeed > 0 && other.y < this.y -
              this.height / 2;


              if (stomping) {
                  this.kill = true;
                  other.vspeed = other.jumpSpeed * 0.6;
              } else {
                  other.die();
              }
            arguments:
              template: mbwpGLt5HFf8mF
            lib: place
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1794506988759
        uid: FPj3DPWgHjhhJJ
        behaviors: []
        extendTypes: ''
