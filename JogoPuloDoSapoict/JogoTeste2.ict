  - type: folder
    uid: Mg5nDp9Hqwzt1j
    colorClass: text
    icon: typescript
    name: Comportamentos
    lastmod: 1794769164748
    entries:
      - type: behavior
        name: inGameRoomStart
        behaviorType: room
        events:
          - eventKey: OnRoomStart
            code: |-
              rooms.current.moedas = 0;
              rooms.current.vidas = 3;
              rooms.current.moedasTotal = templates.list['MoedaAmarela'].length;
              rooms.append('UI');
              const wanted = 'Fase_music';
              if (window.currentMusic !== wanted) {
                  if (window.currentMusic) { sounds.stop(window.currentMusic); }
                  sounds.play(wanted, { loop: true, volume: 0.5 });
                  window.currentMusic = wanted;
              }
            arguments: {}
            lib: core
        specification: []
        extendTypes: ''
        lastmod: 1794768155498
        uid: mTd72hHGQ8PdmN
