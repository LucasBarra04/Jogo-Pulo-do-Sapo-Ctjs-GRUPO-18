            code: |-
              this.page = 0;
              this.pages = [
                  'Na Lagoa Esmeralda vive o Sapo Ninja,\nguardião das moedas de ouro\nque brilham desde os tempos antigos.',
                  'Mas numa noite sem lua, o bando do\nRei Porco invadiu a lagoa, levou todas\nas moedas e as espalhou pelo reino!',
                  'Agora, de bandana vermelha e muito pulo,\no Sapo parte em uma aventura para\nrecuperar cada moeda. Boa sorte!'
              ];

              const wanted = 'Menu_music';
              if (window.currentMusic !== wanted) {
                  if (window.currentMusic) { sounds.stop(window.currentMusic); }
                  sounds.play(wanted, { loop: true, volume: 0.5 });
                  window.currentMusic = wanted;
              }
            arguments: {}
            lib: core
