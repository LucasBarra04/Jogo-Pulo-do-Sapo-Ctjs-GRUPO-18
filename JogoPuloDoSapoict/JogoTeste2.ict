      - type: template
        baseClass: AnimatedSprite
        name: PlataformaMovel
        depth: 0
        texture: ggnLhrRtD3Cj8P
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: >-
              var robot = place.meet(this, this.x, this.y, 'Robot');

              if (robot) {
                  this.cgroup = undefined;
              } else {
                  this.cgroup = 'Solid';
                  robot = place.meet(this, this.x, this.y - 1, 'Robot');
                  if (robot) {
                      robot.x += this.hspeed * u.time;
                  }
              }


              if (place.occupied(this, this.x + this.hspeed * u.time, this.y,
              'Solid')) {
                  // Flip direction
                  this.direction += 180;
              }

              this.move();
            arguments: {}
          - eventKey: OnCreate
            code: this.speed = 120;
            arguments: {}
            lib: core
        extends:
          cgroup: Solid
          'editor:myCollidingCGroups': []
        lastmod: 1794163397600
        uid: q3TF5rjrg8n91K
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: Saida
        depth: 0
        texture: pw9d29cp78862L
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: this.move();
            arguments: {}
          - eventKey: collisionTemplate
            code: |-
              if (rooms.current.nextRoom) {
                  rooms.switch(rooms.current.nextRoom);
              }
            arguments:
              template: mbwpGLt5HFf8mF
            lib: place
        extends:
