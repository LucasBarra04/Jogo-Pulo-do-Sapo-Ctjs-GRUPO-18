          'editor:myCollidingCGroups': []
        lastmod: 1791846641520
        uid: BKhr1r9w3KbQ62
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: Sapo
        depth: 0
        texture: 2jM8q7hhR7t2jd
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnStep
            lib: core
            code: >-
              const axis = actions.MoveX.value;                      // -1 a 1

              const goLeft  = actions.MoveLeft.down  || axis < -0.4; // 0.4 =
              zona morta

              const goRight = actions.MoveRight.down || axis >  0.4;


              if (goLeft) {
                  this.hspeed = -this.movespeed;
                  if (this.tex !== 'NinjaFrog_Run') {
                      this.tex = 'NinjaFrog_Run';
                      this.play();
                  }
                  this.scale.x = -this.baseScale;
              } else if (goRight) {
                  this.hspeed = this.movespeed;
                  if (this.tex !== 'NinjaFrog_Run') {
                      this.tex = 'NinjaFrog_Run';
                      this.play();
                  }
                  this.scale.x = this.baseScale;
              } else {
                  this.hspeed = 0;
                  if (this.tex !== 'NinjaFrog_Idle') {
                      this.tex = 'NinjaFrog_Idle';
                      this.play();
                  }
              }


              if (place.occupied(this, this.x, this.y + 1, 'Solid')) {
                  if (actions.Jump.down) {
                      this.vspeed = this.jumpSpeed;
                  } else {
                      this.vspeed = 0;
                  }
              } else {
                  if (this.tex !== 'NinjaFrog_Jump') {
                      this.tex = 'NinjaFrog_Jump';
                      this.play();
                  }
              }


              if (this.invincible > 0) {
                  this.invincible -= u.time;
              }

              this.alpha = this.invincible > 0 ? 0.5 : 1;
            arguments: {}
          - eventKey: OnCreate
            code: |-
              this.movespeed = 210;
              this.jumpSpeed = -600;
              this.gravity = 1800;

              this.hspeed = 0;
              this.vspeed = 0;

              camera.follow = this;
              camera.borderX = 450;
              camera.borderY = 200;

              this.savedX = this.x;
              this.savedY = this.y;

              this.animationSpeed = 0.20;
              this.baseScale = Math.abs(this.scale.x);

              this.invincible = 0;

              this.die = function () {
                  if (this.invincible > 0) {
                      return;
                  }
                  this.invincible = 1;
                  this.x = this.savedX;
                  this.y = this.savedY;
                  this.hspeed = 0;
                  this.vspeed = 0;
                  rooms.current.vidas--;
                  if (rooms.current.vidas <= 0) {
                      rooms.switch(rooms.current.name);
                  }
              };
            arguments: {}
            lib: core
          - eventKey: OnDraw
            code: this.moveSmart('Solid');
            arguments: {}
            lib: core
          - eventKey: collisionCGroup
            code: this.die();
            arguments:
              group: Mortal
            lib: place
          - eventKey: OnActionPress
            code: |-
              if (rooms.list['UI_Paused'].length === 0) {
                  rooms.append('UI_Paused', { isUi: true });
                  pixiApp.ticker.speed = 0;
              } else {
                  rooms.remove(rooms.list['UI_Paused'][0]);
                  pixiApp.ticker.speed = 1;
              }
            arguments:
              action: Pause
            lib: core
        extends:
          cgroup: ''
          'editor:myCollidingCGroups': []
        lastmod: 1794687603260
        uid: mbwpGLt5HFf8mF
        behaviors: []
        extendTypes: ''
      - type: template
        baseClass: AnimatedSprite
        name: Button_Play
        depth: 0
